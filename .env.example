# Copy this file to .env and fill in the values. Never commit .env.

# From @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash



# Your Telegram user id(s), comma separated. Admins have no daily limit.
ADMIN_IDS=

# Free-hosting protection
DAILY_LIMIT=5
MAX_PARALLEL_JOBS=1

# Short AI clip generation: hf (free Hugging Face Space), veo (paid, Gemini API billing needed), none
VIDEO_PROVIDER=hf
# Free token from https://huggingface.co/settings/tokens (read access). Gives you a bigger GPU quota than anonymous use.
HF_TOKEN=
HF_SPACE=Lightricks/ltx-2
HF_API_NAME=/generate_video
VEO_MODEL=veo-3.1-fast-generate-preview

# Needed for "My own voice" (accept the terms at https://huggingface.co/kyutai/pocket-tts first)
# HF_TOKEN above is used for this too.
